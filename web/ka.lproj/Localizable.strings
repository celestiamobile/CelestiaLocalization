"FRONT_PAGE_DESCRIPTION_HEADER_1" = "3D კოსმოსური სიმულატორი";
"FRONT_PAGE_DESCRIPTION_MESSAGE_1" = "Celestia მოახდენს ბევრი სხვადასხვა ციური ობიექტის სიმულაციას. პლანეტებიდან და მთვარეებიდან ვარსკვლავთა გროვებამდე და გალაქტიკებამდე — შეგიძლიათ ეწვიოთ ყველა ობიექტს გაფართოებად მონაცემთა ბაზაში და დაათვალიეროთ ისინი სივრცე-დროის ნებისმიერი წერტილიდან. მზის სისტემის ობიექტების მდებარეობა და მოძრაობა ზუსტად გამოითვლება რეალურ დროში ნებისმიერი სასურველი სიჩქარით.";
"FRONT_PAGE_DESCRIPTION_HEADER_2" = "ინტერაქტიული პლანეტარიუმი";
"FRONT_PAGE_DESCRIPTION_MESSAGE_2" = "Celestia მუშაობს როგორც პლანეტარიუმი — ნებისმიერ ციურ სხეულზე მყოფი დამკვირვებლისთვის. შეგიძლიათ მარტივად გადახვიდეთ ნებისმიერ სამყაროზე და დაეშვათ მის ზედაპირზე. Celestia ცაზე გვიჩვენებს მზის სისტემის ობიექტების ზუსტ მდებარეობებს, ეტიკეტებითა და დამხმარე ფუნქციებით, რომელთა ჩართვა-გამორთვა შესაძლებელია.";

