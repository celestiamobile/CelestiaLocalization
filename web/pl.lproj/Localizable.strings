"FRONT_PAGE_DESCRIPTION_MESSAGE" = "Celestia to bezpłatny symulator kosmosu dla systemów Windows, Linux, macOS, iOS i Android. Można swobodnie eksplorować przestrzeń w trzech wymiarach.";

